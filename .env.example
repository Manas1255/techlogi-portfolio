# Copy to .env.local and fill in. Every variable here is declared and validated
# in src/config/env.ts, so add new ones there first or the app won't start.

# ── Browser-visible (NEXT_PUBLIC_* only) ────────────────────────────────────

# Display name. Drives metadata, the wordmark and the structured data.
NEXT_PUBLIC_APP_NAME=GA Studio

# Canonical origin. Used for canonical URLs, Open Graph and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://gastudio.com

# Where the browser sends the project inquiry. Only used once
# siteConfig.inquiry.endpoint is set; until then the form takes a logged
# mock-success path and never calls out.
NEXT_PUBLIC_API_URL=https://api.gastudio.com

# ── Server-only (NEVER prefixed NEXT_PUBLIC_) ───────────────────────────────

# Backend URL for server-side calls. Defaults to NEXT_PUBLIC_API_URL when
# unset; set it only when the server reaches the backend over a different
# (e.g. internal) address than the browser does.
# BACKEND_API_URL=https://api.gastudio.com
